# =============================================================================
# Plantilla de variables de entorno — OpenCode + NVIDIA Build
# -----------------------------------------------------------------------------
# 1. Copia este archivo:  Copy-Item .env.example .env
# 2. Con la config por defecto del repo basta UNA clave: NVIDIA_API_KEY_GPTOSS
#    (modelo principal y small_model apuntan al mismo provider en opencode.json).
# 3. Añade NVIDIA_API_KEY_KIMI, MISTRAL, QWEN, etc. si usas /models con esos.
# 4. Nunca subas `.env` a git (está en .gitignore).
# =============================================================================

# --- NVIDIA Build (OpenAI-compatible) — una variable por provider usado ---
# Obtén cada clave en https://build.nvidia.com (página del modelo → Get API Key)
NVIDIA_API_KEY_MISTRAL=
NVIDIA_API_KEY_KIMI=
NVIDIA_API_KEY_QWEN=
NVIDIA_API_KEY_GPTOSS=

# Opcional: mismo patrón si añades más providers (ver config/providers.template.json)
# NVIDIA_API_KEY_DEEPSEEK=
# NVIDIA_API_KEY_NEMOTRON=

# --- Google AI (Gemini) — opcional, solo si usas el provider `google` en opencode.json ---
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=   # solo si alguna herramienta la requiere explícitamente

# --- Brave Search MCP — opcional; pon la clave y activa el MCP en opencode.json ---
BRAVE_API_KEY=

# --- Prueba con `.\start.ps1 -Test` (modelo de smoke test) ---
# NVIDIA_TEST_MODEL=mistralai/mistral-medium-3.5-128b
